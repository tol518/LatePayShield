# LatePay Shield — TESTNET ONLY. Never place mainnet keys or real funds here.
# Copy to .env (git-ignored) and fill in. .env must never be committed.

# --- Flare Coston2 (chain id 114) ---
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_CHAIN_ID=114

FDC_ABI_ENCODED_REQUEST=

# Populated after deployment.
LATEPAY_SHIELD_ADDRESS=

# --- Flare Data Connector (hosted services) ---
FDC_VERIFIER_BASE_URL=https://fdc-verifiers-testnet.flare.network
# Flare publishes this key for the testnet verifiers. It is not a secret.
FDC_VERIFIER_API_KEY=00000000-0000-0000-0000-000000000000
FDC_DA_LAYER_BASE_URL=https://ctn2-data-availability.flare.network
# Paste only the public abiEncodedRequest returned by the FDC verifier.
# Leave blank to use whatever `npm run fdc:prepare` last wrote to evidence/.
FDC_ABI_ENCODED_REQUEST=
# Voting round to fetch the proof from. Blank uses the round recorded by fdc:submit.
FDC_VOTING_ROUND=
# Public EVM address the proof is issued to. Blank derives it from COSTON2_PRIVATE_KEY.
FDC_PROOF_OWNER=
# Agreement the fetched proof is submitted against by `npm run fdc:record`.
AGREEMENT_ID=

# --- XRPL Testnet ---
XRPL_WSS_URL=wss://s.altnet.rippletest.net:51233
# Seed for a THROWAWAY faucet-funded XRPL Testnet wallet only.
XRPL_PAYER_SEED=
# Destination for the payment. Set this before creating an agreement so the
# agreement exists first; spike:xrpl pays it instead of funding a new wallet.
XRPL_SUPPLIER_ADDRESS=

# --- Local AI assistant (optional; docs/ai/SKILLS.md) ---
# Off by default. The full agreement lifecycle must work with the model stopped.
AI_ASSISTANT_ENABLED=false
# OpenAI-compatible base URL of the model process, including /v1. The model runs
# on the operator's own hardware; only web/server talks to it, never the browser.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=mlx-community/Qwen3-8B-4bit
# A local 8B model with thinking enabled can take tens of seconds per request.
LOCAL_LLM_TIMEOUT_MS=180000

# --- Local web service access control (web/server/access.js) ---
# Default: loopback only. The service binds 127.0.0.1, generates one operator
# token per run, and serves it in its own page. Reaching the port is never
# permission on its own.
XAMAN_SERVER_HOST=127.0.0.1
XAMAN_SERVER_PORT=8787
# Optional stable operator tokens, written as operatorId:token pairs separated
# by commas. Each token must be at least 24 characters and belongs to one
# operator; case files are owned by, and readable only by, that operator.
# Treat a token like a password: never commit it or put it in a VITE_ variable.
WEB_OPERATOR_TOKENS=
# Required to bind anything other than loopback, together with
# WEB_OPERATOR_TOKENS and WEB_ALLOWED_ORIGINS. Without all three the service
# refuses to start instead of exposing case data.
WEB_AUTHENTICATED_DEPLOYMENT=false
# Absolute origins allowed to make requests in an authenticated deployment,
# comma separated, for example https://cases.internal.example.
WEB_ALLOWED_ORIGINS=

# --- Eligibility questionnaire (web/shared/eligibility.js) ---
# High-value routing threshold, in minor units (pence). Must carry the VITE_
# prefix because assess() runs in the browser and Vite exposes nothing else to
# the bundle. Blank or non-integer falls back to the 5000000 (£50,000) default.
VITE_ELIGIBILITY_HIGH_VALUE_MINOR_UNITS=

# --- Agreement terms ---
# create:agreement and spike:xrpl must agree on these or the proof will not match
# the recorded terms. Defaults shown are what both scripts use when unset.
INVOICE_REFERENCE=INV-2026-001
DESTINATION_TAG=2026001
AMOUNT_DROPS=2000000
SUPPLIER_NAME=Maya Design Studio
PAYER_NAME=Acme Ltd
# Minutes from now until the agreement deadline. The payment must be validated
# and its FDC round finalized before this passes.
DUE_IN_MINUTES=120
